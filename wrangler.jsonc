{
  "name": "rift-legion",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "Lobby", "class_name": "Lobby" },
      { "name": "Match", "class_name": "Match" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby", "Match"] }]
}
